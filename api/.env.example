# Ollama connection. Inside Docker Compose this points at the ollama_server
# container; if you're running the API outside Docker against a local
# Ollama install, use http://localhost:11434 instead.
OLLAMA_BASE_URL=http://ollama_server:11434

# Model to use for all agents. llama3.1:latest is the shipped default; if
# you're on a smaller/older GPU, llama3.2:3b is a much lighter alternative
# (see README "Model choice" notes for a measured comparison).
OLLAMA_MODEL=llama3.1:latest

# Where trained RSI models are cached (see api/tools/stockPriceAnaliserTool.py).
MODEL_DIR=models

# SQLite database file for prediction history.
DB_PATH=data/predictions.db

# How long (seconds) an identical /get_insights request is served from cache
# before the full pipeline re-runs.
CACHE_TTL_SECONDS=600
