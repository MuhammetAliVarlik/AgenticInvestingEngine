# Copy to .env and fill in. Never commit .env - it is git-ignored.

# --- LLM ---------------------------------------------------------------------
# "ollama" (local, private, needs a GPU for good speed) or "groq" (hosted, free tier).
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:latest
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- Data sources ------------------------------------------------------------------
# Free key: https://evds3.tcmb.gov.tr -> sign up -> Profile -> API Key
EVDS_API_KEY=
# Yahoo Finance is for personal, local use only. Never enable in a deployed build.
ENABLE_YFINANCE=false

# --- Guardrails ----------------------------------------------------------------
# Model-based injection classifier (Llama Prompt Guard 2 on Groq), on top of heuristics.
ENABLE_PROMPT_GUARD=false

# --- Observability ------------------------------------------------------------------
# Free Langfuse Cloud project (EU): https://cloud.langfuse.com -> Settings -> API keys
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Random value; hashes user identities in traces and usage counters.
TELEMETRY_SALT=change-me-to-a-random-string

# --- Budgets (per user, per UTC day) --------------------------------------------------
DAILY_ANALYSES_PER_USER=20
DAILY_TOKENS_PER_USER=200000

# --- Storage ----------------------------------------------------------------------
DB_PATH=data/predictions.db
MODEL_DIR=models
CACHE_TTL_SECONDS=600

# --- Request limits -----------------------------------------------------------------
MAX_SYMBOLS_PER_REQUEST=3

# --- Web gateway: anonymous access codes (optional, docker compose) ----------------
# Leave AUTH_PROVIDER=none for the local demo. Only the holder of
# ACCESS_CODE_SECRET can make codes: generate it locally, keep it in .env only.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
AUTH_PROVIDER=none
ACCESS_CODE_SECRET=
# Maximum analyses per day for all access codes together.
GLOBAL_DAILY_ANALYSES=12
# Owner alerts by e-mail (no personal data). Gmail: smtp.gmail.com + app password.
ALERT_EMAIL_TO=
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
